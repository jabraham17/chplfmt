record R {
  var v: int;
  proc f() { }
  proc ref setV(x: int) do v = x;
  proc const ref getV() const ref: int do return v;
  proc paramRet() param do return 1;
  proc typeRet() type do return int;
  proc parenless do return v;
  proc parenlessType type do return int;
  override proc hash(): uint do return 0;
  iter these() do yield v;
  iter these(param tag: iterKind) where tag == iterKind.standalone do yield v;
}
proc R.g() { }
proc (R).h() { }
proc type R.make(): R do return new R();
inline proc fast(x: int): int do return x;
proc mayThrow() throws { }
export proc exported(x: int): int do return x;
extern proc cfunc(x: c_int): c_int;
extern "real_name" proc renamed(): void;
operator +(a: R, b: R): R do return a;
operator R.==(a: R, b: R): bool do return true;
operator :(x: int, type t: R) do return new R();
iter count(n: int): int {
  for i in 1..n do yield i;
}
proc double(x: int) do return 2 * x;
proc shiftLeft(x: vectorType(eltType, numElts), param shift: int): x.type do
  return implType(eltType, numElts).shiftLeftImm(x, shift);
proc tooLongBodyEvenAlone(x: int) do
  return someVeryLongFunctionName(argumentNumberOne, argumentNumberTwo, x);
proc doBlock() { }
proc spaced(x: int): int do return x;
const lam = proc(x: int) {
  return x;
};
