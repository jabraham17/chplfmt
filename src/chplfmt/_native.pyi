from collections.abc import Sequence
from typing import Any, final

@final
class TokenKind:
    IDENT: TokenKind
    NUMBER: TokenKind
    STRING: TokenKind
    LINE_COMMENT: TokenKind
    BLOCK_COMMENT: TokenKind
    PUNCT: TokenKind
    OPAQUE: TokenKind
    EOF: TokenKind

    def __str__(self) -> str: ...
    def __format__(self, spec: str) -> str: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

@final
class Token:
    @property
    def kind(self) -> TokenKind: ...
    @property
    def text(self) -> str: ...
    @property
    def start_offset(self) -> int: ...
    @property
    def end_offset(self) -> int: ...
    @property
    def start(self) -> tuple[int, int]: ...
    @property
    def end(self) -> tuple[int, int]: ...
    @property
    def nl_before(self) -> int: ...
    @property
    def ws_before(self) -> bool: ...
    @property
    def match(self) -> int | None: ...
    @property
    def is_comment(self) -> bool: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class NativeLexError(Exception):
    offset: int
    reason: str
    char: str | None

class NativeIndex:
    @property
    def source(self) -> Any: ...
    @property
    def roots(self) -> Any: ...
    @property
    def tokens(self) -> list[Token]: ...
    @property
    def problems(self) -> list[str]: ...
    def nodes(self) -> list[Any]: ...
    def find_start(self, position: tuple[int, int]) -> int | None: ...
    def find_end(self, position: tuple[int, int]) -> int | None: ...
    def span(self, location: Any) -> tuple[int, int] | None: ...
    def node_span(self, node: Any) -> tuple[int, int] | None: ...
    def header_span(self, node: Any) -> tuple[int, int] | None: ...
    def body_span(self, node: Any) -> tuple[int, int] | None: ...
    def stmt_span(self, node: Any) -> tuple[int, int] | None: ...
    def next_code(self, token: int) -> int: ...
    def prev_code(self, token: int) -> int | None: ...
    def structural_brackets(self, node: Any) -> list[int]: ...
    def user_parens(self, node: Any) -> list[tuple[int, int, Any]]: ...
    def parens_around(self, node: Any) -> list[tuple[int, int]]: ...
    def unexplained_brackets(self, node: Any) -> list[int]: ...
    def body_delimiters(self, node: Any) -> list[int]: ...
    def is_wide_identifier(self, node: Any) -> bool: ...
    def owner(self, token: int) -> Any | None: ...
    def parent(self, node: Any) -> Any | None: ...
    def children(self, node: Any) -> list[Any]: ...
    def ast_children(self, node: Any) -> list[Any]: ...
    def own_tokens(self, node: Any) -> list[int]: ...
    def check_leaves(self) -> list[str]: ...
    def check_ownership(self) -> list[str]: ...

def build_index(source: Any, roots: Any, classify: Any, comment: Any, extern_block: Any) -> NativeIndex: ...
def lex(text: str, opaque: Sequence[tuple[int, int]]) -> list[Token]: ...
def char_width(ch: str) -> int: ...
def display_width(text: str, start_col: int = 0, tab_size: int = 2) -> int: ...
