from collections.abc import Sequence
from typing import final

@final
class TokenKind:
    IDENT: TokenKind
    NUMBER: TokenKind
    STRING: TokenKind
    LINE_COMMENT: TokenKind
    BLOCK_COMMENT: TokenKind
    PUNCT: TokenKind
    OPAQUE: TokenKind
    EOF: TokenKind

    def __str__(self) -> str: ...
    def __format__(self, spec: str) -> str: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

@final
class Token:
    @property
    def kind(self) -> TokenKind: ...
    @property
    def text(self) -> str: ...
    @property
    def start_offset(self) -> int: ...
    @property
    def end_offset(self) -> int: ...
    @property
    def start(self) -> tuple[int, int]: ...
    @property
    def end(self) -> tuple[int, int]: ...
    @property
    def nl_before(self) -> int: ...
    @property
    def ws_before(self) -> bool: ...
    @property
    def match(self) -> int | None: ...
    @property
    def is_comment(self) -> bool: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class NativeLexError(Exception):
    offset: int
    reason: str
    char: str | None

def lex(text: str, opaque: Sequence[tuple[int, int]]) -> list[Token]: ...
def char_width(ch: str) -> int: ...
def display_width(text: str, start_col: int = 0, tab_size: int = 2) -> int: ...
