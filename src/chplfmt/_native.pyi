from collections.abc import Callable, Sequence
from typing import Any, final

__build__: str

@final
class TokenKind:
    IDENT: TokenKind
    NUMBER: TokenKind
    STRING: TokenKind
    LINE_COMMENT: TokenKind
    BLOCK_COMMENT: TokenKind
    PUNCT: TokenKind
    OPAQUE: TokenKind
    EOF: TokenKind

    def __str__(self) -> str: ...
    def __format__(self, spec: str) -> str: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

@final
class Token:
    @property
    def kind(self) -> TokenKind: ...
    @property
    def text(self) -> str: ...
    @property
    def start_offset(self) -> int: ...
    @property
    def end_offset(self) -> int: ...
    @property
    def start(self) -> tuple[int, int]: ...
    @property
    def end(self) -> tuple[int, int]: ...
    @property
    def nl_before(self) -> int: ...
    @property
    def ws_before(self) -> bool: ...
    @property
    def match(self) -> int | None: ...
    @property
    def is_comment(self) -> bool: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

class NativeLexError(Exception):
    offset: int
    reason: str
    char: str | None

@final
class VerificationIndex:
    @property
    def source(self) -> Any: ...
    @property
    def roots(self) -> Any: ...
    @property
    def tokens(self) -> list[Token]: ...
    def node_span(self, node: Any) -> tuple[int, int] | None: ...
    def ast_children(self, node: Any) -> list[Any]: ...

class NativeIndex:
    def __init__(
        self, source: Any, roots: Any, classify: Any, comment: Any, extern_block: Any
    ) -> None: ...
    @property
    def source(self) -> Any: ...
    @property
    def roots(self) -> Any: ...
    @property
    def tokens(self) -> list[Token]: ...
    @property
    def problems(self) -> list[str]: ...
    def nodes(self) -> list[Any]: ...
    def verification_view(self) -> VerificationIndex: ...
    def find_start(self, position: tuple[int, int]) -> int | None: ...
    def find_end(self, position: tuple[int, int]) -> int | None: ...
    def span(self, location: Any) -> tuple[int, int] | None: ...
    def node_span(self, node: Any) -> tuple[int, int] | None: ...
    def header_span(self, node: Any) -> tuple[int, int] | None: ...
    def body_span(self, node: Any) -> tuple[int, int] | None: ...
    def stmt_span(self, node: Any) -> tuple[int, int] | None: ...
    def next_code(self, token: int) -> int: ...
    def prev_code(self, token: int) -> int | None: ...
    def structural_brackets(self, node: Any) -> list[int]: ...
    def user_parens(self, node: Any) -> list[tuple[int, int, Any]]: ...
    def parens_around(self, node: Any) -> list[tuple[int, int]]: ...
    def unexplained_brackets(self, node: Any) -> list[int]: ...
    def body_delimiters(self, node: Any) -> list[int]: ...
    def is_wide_identifier(self, node: Any) -> bool: ...
    def owner(self, token: int) -> Any | None: ...
    def parent(self, node: Any) -> Any | None: ...
    def children(self, node: Any) -> list[Any]: ...
    def ast_children(self, node: Any) -> list[Any]: ...
    def own_tokens(self, node: Any) -> list[int]: ...
    def check_leaves(self) -> list[str]: ...
    def check_ownership(self) -> list[str]: ...

def build_index(
    source: Any, roots: Any, classify: Any, comment: Any, extern_block: Any
) -> NativeIndex: ...
def lex(text: str, opaque: Sequence[tuple[int, int]]) -> list[Token]: ...
def char_width(ch: str) -> int: ...
def display_width(text: str, start_col: int = 0, tab_size: int = 2) -> int: ...
@final
class DocKind:
    TEXT: DocKind
    CONCAT: DocKind
    GROUP: DocKind
    INDENT: DocKind
    ALIGN: DocKind
    LINE: DocKind
    FILL: DocKind
    IF_BREAK: DocKind
    LINE_SUFFIX: DocKind
    TRAILING_COMMENT: DocKind
    BREAK_PARENT: DocKind
    CONDITIONAL_GROUP: DocKind
    VERBATIM: DocKind
    COLUMN_TEXT: DocKind
    SUFFIX_BREAK: DocKind
    ON_RENDER: DocKind

@final
class Doc:
    @property
    def forced(self) -> bool: ...
    @property
    def flat_width(self) -> int: ...
    @property
    def kind(self) -> DocKind: ...
    @property
    def parts(self) -> tuple[Doc, ...]: ...
    def unpack(self) -> tuple[Any, ...]: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

@final
class GroupId:
    def __init__(self, name: str = "g") -> None: ...
    @property
    def name(self) -> str: ...
    def __eq__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...

@final
class Check:
    FIRST_LINE: Check
    ALL_LINES: Check

FIRST_LINE: Check
ALL_LINES: Check
EMPTY: Doc
line: Doc
softline: Doc
hardline: Doc
literalline: Doc
break_parent: Doc
suffix_break: Doc

type DocLike = Doc | str

def text(s: str) -> Doc: ...
def concat(*docs: DocLike) -> Doc: ...
def group(
    doc: DocLike, id: GroupId | None = None, should_break: bool = False
) -> Doc: ...
def indent(doc: DocLike, n: int) -> Doc: ...
def align(doc: DocLike) -> Doc: ...
def fill(parts: Sequence[DocLike], *, lazy: bool = False) -> Doc: ...
def if_break(
    broken: DocLike, flat: DocLike = "", group_id: GroupId | None = None
) -> Doc: ...
def line_suffix(doc: DocLike) -> Doc: ...
def trailing_comment(comment: str) -> Doc: ...
def conditional_group(alts: Sequence[DocLike], check: Check = FIRST_LINE) -> Doc: ...
def verbatim(s: str, bol: bool = False) -> Doc: ...
def column_text(make: Callable[[int], str]) -> Doc: ...
def on_render(fn: Callable[[], None]) -> Doc: ...
def flatten(doc: DocLike) -> Doc | None: ...
def dump(doc: DocLike) -> str: ...
@final
class LineRecord:
    def __init__(
        self, code: str, trailing_comment: str | None = None, verbatim: bool = False
    ) -> None: ...
    @property
    def code(self) -> str: ...
    @property
    def trailing_comment(self) -> str | None: ...
    @property
    def verbatim(self) -> bool: ...
    def __eq__(self, other: object) -> bool: ...

@final
class RenderStats:
    @property
    def fits_scans(self) -> int: ...
    @property
    def all_lines_dry_runs(self) -> int: ...
    @property
    def memo_hits(self) -> int: ...

@final
class RenderResult:
    @property
    def text(self) -> str: ...
    @property
    def lines(self) -> list[LineRecord]: ...
    @property
    def stats(self) -> RenderStats: ...

def render(
    doc: DocLike, line_length: int, tab_size: int, base_indent: int = 0
) -> RenderResult: ...
def render_text(
    doc: DocLike, line_length: int, tab_size: int, base_indent: int = 0
) -> str: ...
def flat_width(doc: DocLike, tab_size: int) -> int | None: ...
def align_trailing_comments(
    lines: Sequence[LineRecord], line_length: int, tab_size: int
) -> list[str]: ...
